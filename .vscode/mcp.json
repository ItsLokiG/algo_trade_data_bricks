{
  "inputs": [
    {
      "type": "promptString",
      "id": "tapetide-token",
      "description": "Tapetide API token (sent to mcp.tapetide.com)",
      "password": true
    }
  ],
  "servers": {
    "tapetide": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "tapetide-mcp==1.0.1", "tapetide-mcp"],
      "env": {
        "TAPETIDE_TOKEN": "${input:tapetide-token}"
      }
    }
  }
}
